# Enable deep route selection.
DEEP_ENABLED=false

# Deep upstream auth for OpenAI-compatible endpoint.
DEEP_API_KEY=

# Optional overrides.
# DEEP_BASE_URL=https://api.openai.com
# DEEP_MODEL_ID=gpt-5.4-mini

# Local LLM traffic logging.
# ROUTER_LOCAL_LLM_LOG_ENABLED=true
# ROUTER_LOCAL_LLM_LOG_FILE=logs/local_llm_traffic.jsonl
