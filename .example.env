# Example local router configuration
LLMROUTER_PORT=12345

# Real LM Studio local-model integration
LLMROUTER_LMSTUDIO_BASE_URL=http://192.168.178.2:1234
# Optional: set explicit routing expectations per scenario.
# If these stay unset, the test loader will discover the first model from GET /v1/models
# and use it for both the short-context and long-context live checks.
# LLMROUTER_LMSTUDIO_SHORT_MODEL_ID=your-short-model-id
# LLMROUTER_LMSTUDIO_SHORT_CONTEXT_TOKENS=8192
# LLMROUTER_LMSTUDIO_LONG_MODEL_ID=your-long-model-id
# LLMROUTER_LMSTUDIO_LONG_CONTEXT_TOKENS=32768
# LLMROUTER_LMSTUDIO_TOOL_MODEL_ID=your-tool-model-id
# LLMROUTER_LMSTUDIO_TOOL_CONTEXT_TOKENS=8192
# LLMROUTER_LMSTUDIO_VISION_MODEL_ID=your-vision-model-id
# LLMROUTER_LMSTUDIO_VISION_CONTEXT_TOKENS=8192
